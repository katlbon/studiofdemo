{
  "$extends": ["#/$defs/base-component"],
  "$componentKey": "CategoryCarousel",
  "$componentTitle": "Category Carousel",
  "title": "Category Carousel",
  "description": "Scrollable row of category image tiles with a title and call to action",
  "type": "object",
  "required": ["items"],
  "properties": {
    "title": {
      "title": "Section title",
      "type": "string",
      "description": "Underlined heading shown above the carousel, e.g. Women"
    },
    "items": {
      "title": "Categories",
      "type": "array",
      "minItems": 1,
      "items": {
        "title": "Category",
        "type": "object",
        "required": ["title", "image", "link"],
        "properties": {
          "title": {
            "title": "Title",
            "type": "string"
          },
          "image": {
            "title": "Image",
            "type": "object",
            "required": ["src"],
            "properties": {
              "src": {
                "title": "Image URL",
                "type": "string",
                "description": "Full image URL, e.g. a product photo from the catalog"
              },
              "alt": {
                "title": "Alternative Label",
                "type": "string"
              }
            }
          },
          "link": {
            "title": "Call to Action",
            "type": "object",
            "required": ["text", "url"],
            "properties": {
              "text": {
                "title": "Text",
                "type": "string",
                "default": "Ver más"
              },
              "url": {
                "title": "URL",
                "type": "string"
              },
              "linkTargetBlank": {
                "title": "Open link in new window?",
                "type": "boolean",
                "default": false
              }
            }
          }
        }
      }
    }
  }
}
