{
  "$extends": [
    "#/$defs/base-component"
  ],
  "$componentKey": "ShipinBankPromos",
  "$componentTitle": "Shipin Bank Promotions",
  "title": "Shipin Bank Promotions",
  "description": "Bank logo cards with installment offers",
  "type": "object",
  "required": [
    "cards"
  ],
  "properties": {
    "title": {
      "title": "Title",
      "type": "string",
      "default": "Descuentos y cuotas sin interés con tu banco"
    },
    "variant": {
      "title": "Card style",
      "type": "string",
      "enum": [
        "promo",
        "info"
      ],
      "default": "promo"
    },
    "cards": {
      "title": "Cards",
      "type": "array",
      "items": {
        "title": "Card",
        "type": "object",
        "required": [
          "image"
        ],
        "properties": {
          "image": {
            "title": "Image URL",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "url": {
            "title": "Link URL",
            "type": "string"
          }
        }
      },
      "default": [
        {
          "image": "https://mundofixar.vtexassets.com/assets/vtex.file-manager-graphql/images/70a96e7f-94d5-4e08-a781-538977bc32d6___ff22eb6ab339cb46c64bc96d0638ca69.png",
          "title": "Naranja X",
          "text": "20% OFF con Plan Z, 12 cuotas sin interés + 10% OFF o 14 cuotas sin interés"
        },
        {
