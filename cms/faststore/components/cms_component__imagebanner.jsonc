{
  "$extends": [
    "#/$defs/base-component"
  ],
  "$componentKey": "ImageBanner",
  "$componentTitle": "Image Banner",
  "title": "Image Banner",
  "description": "Thin full-width promotional image strip",
  "type": "object",
  "required": [
    "image"
  ],
  "properties": {
    "image": {
      "title": "Image",
      "type": "object",
      "required": [
        "src"
      ],
      "properties": {
        "src": {
          "title": "Image URL",
          "type": "string",
          "description": "Full image URL"
        },
        "alt": {
          "title": "Alternative Label",
          "type": "string"
        }
      }
    },
    "url": {
      "title": "Link URL",
      "type": "string"
    },
    "linkTargetBlank": {
      "title": "Open link in new window?",
      "type": "boolean",
      "default": false
    }
  }
}
