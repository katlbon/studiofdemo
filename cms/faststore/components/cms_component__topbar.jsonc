{
  "$extends": [
    "#/$defs/base-component"
  ],
  "$componentKey": "TopBar",
  "$componentTitle": "Top Bar",
  "title": "Top Bar",
  "description": "Thin dark strip above the header with store links",
  "type": "object",
  "required": [
    "links"
  ],
  "properties": {
    "links": {
      "title": "Links",
      "type": "array",
      "minItems": 1,
      "items": {
        "title": "Link",
        "type": "object",
        "required": [
          "text",
          "url"
        ],
        "properties": {
          "text": {
            "title": "Text",
            "type": "string"
          },
          "url": {
            "title": "URL",
            "type": "string"
          },
          "linkTargetBlank": {
            "title": "Open link in new window?",
            "type": "boolean",
            "default": false
          }
        }
      }
    }
  }
}
