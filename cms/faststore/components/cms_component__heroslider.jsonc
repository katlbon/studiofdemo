{
  "$extends": [
    "#/$defs/base-component"
  ],
  "$componentKey": "HeroSlider",
  "$componentTitle": "Hero Slider",
  "title": "Hero Slider",
  "description": "Full-width image slider with dots and autoplay",
  "type": "object",
  "required": [
    "slides"
  ],
  "properties": {
    "slides": {
      "title": "Slides",
      "type": "array",
      "minItems": 1,
      "items": {
        "title": "Slide",
        "type": "object",
        "required": [
          "image"
        ],
        "properties": {
          "image": {
            "title": "Image",
            "type": "object",
            "required": [
              "src"
            ],
            "properties": {
              "src": {
                "title": "Image URL",
                "type": "string",
                "description": "Full image URL"
              },
              "alt": {
                "title": "Alternative Label",
                "type": "string"
              }
            }
          },
          "url": {
            "title": "Link URL",
            "type": "string"
          }
        }
      }
    },
    "autoplaySeconds": {
      "title": "Autoplay interval (seconds, 0 = off)",
      "type": "integer",
      "default": 6
    }
  }
}
