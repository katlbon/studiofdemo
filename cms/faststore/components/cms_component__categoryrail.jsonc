{
  "$extends": [
    "#/$defs/base-component"
  ],
  "$componentKey": "CategoryRail",
  "$componentTitle": "Category Rail",
  "title": "Category Rail",
  "description": "NEW ARRIVALS rail: 3:4 category photos with a white label",
  "type": "object",
  "properties": {
    "title": {
      "title": "Title",
      "type": "string",
      "default": "NEW ARRIVALS"
    },
    "items": {
      "title": "Categories",
      "type": "array",
      "items": {
        "title": "Category",
        "type": "object",
        "required": [
          "image",
          "label",
          "url"
        ],
        "properties": {
          "image": {
            "title": "Image URL",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "url": {
            "title": "Link URL",
            "type": "string"
          }
        }
      }
    }
  }
}
