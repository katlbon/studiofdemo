{
  "$extends": [
    "#/$defs/base-component"
  ],
  "$componentKey": "Marquee",
  "$componentTitle": "Marquee",
  "title": "Marquee",
  "description": "Full-width strip of promo messages that scrolls continuously",
  "type": "object",
  "required": [
    "messages"
  ],
  "properties": {
    "messages": {
      "title": "Messages",
      "type": "array",
      "minItems": 1,
      "items": {
        "title": "Message",
        "type": "string"
      }
    },
    "speed": {
      "title": "Seconds per loop (lower is faster)",
      "type": "integer",
      "default": 40,
      "minimum": 5
    }
  }
}
