{
  "$extends": [
    "#/$defs/base-component"
  ],
  "$componentKey": "ShipinInfoCards",
  "$componentTitle": "Shipin Info Cards",
  "title": "Shipin Info Cards",
  "description": "Brand story cards with image, text and button",
  "type": "object",
  "required": [
    "cards"
  ],
  "properties": {
    "title": {
      "title": "Title",
      "type": "string",
      "default": ""
    },
    "variant": {
      "title": "Card style",
      "type": "string",
      "enum": [
        "promo",
        "info"
      ],
      "default": "info"
    },
    "buttonLabel": {
      "title": "Button label",
      "type": "string",
      "default": "Ver más"
    },
    "cards": {
      "title": "Cards",
      "type": "array",
      "items": {
        "title": "Card",
        "type": "object",
        "required": [
          "image"
        ],
        "properties": {
          "image": {
            "title": "Image URL",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "url": {
            "title": "Link URL",
            "type": "string"
          }
        }
      },
      "default": [
        {
          "image": "https://mundofixar.vtexassets.com/assets/vtex.file-manager-graphql/images/f40b1670-4f5d-4b2e-8795-a5de36e3a486___21e4b7e863cbc3e083a749a2e86f0e68.png",
          "title": "AIPER: El aliado de tu piscina.",
          "text": "Olvidate de limpiar la pileta y dedicate solo a disfrutarla. Aiper revoluciona el mantenimiento del hogar con sus robots limpiafondos inalámbricos de alta tecnología.",
          "url": "/s?q=AIPER"
        },
        {
          "image": "https://mundofixar.vtexassets.com/assets/vtex.file-manager-graphql/images/ed85a01d-b335-475d-b283-9a71071d405f___235a68777adef88353d8920df5fe8b4f.png",
          "title": "ANTHBOT: La revolución de tu jardín.",
          "text": "El mantenimiento de tu jardín, ahora en piloto automático. Robots cortacésped inteligentes con navegación satelital de alta precisión.",
          "url": "/s?q=ANTHBOT"
        },
        {
          "image": "https://mundofixar.vtexassets.com/assets/vtex.file-manager-graphql/images/9ba00f9a-6d5a-42f3-8ff0-9869c60d3e3b___e47db475fc739aca75be0afa73dbf2f2.png",
          "title": "REDRAGON: Rendimiento y estilo para tu setup.",
          "text": "Periféricos que combinan tecnología avanzada, switches de alta respuesta y diseño ergonómico.",
          "url": "/s?q=REDRAGON"
        },
        {
          "image": "https://mundofixar.vtexassets.com/assets/vtex.file-manager-graphql/images/468ee6eb-8748-4962-b0bc-d6feef1ca17b___f60f4862507aa50a5c4aca4f59ddc6f2.png",
          "title": "CECOTEC: Tecnología que simplifica tu hogar.",
          "text": "Electrodomésticos con diseño premium, eficiencia máxima y automatización inteligente para darte más tiempo libre.",
          "url": "/s?q=CECOTEC"
        },
        {
          "image": "https://mundofixar.vtexassets.com/assets/vtex.file-manager-graphql/images/57acd2fa-0c0f-495f-aa95-0378df447c4c___972c8dde7bf39863d40f1ebb1e0213ef.png",
          "title": "COOKUT: El diseño sustentable de tu cocina",
          "text": "Utensilios de diseño premium con materiales sustentables, colores vibrantes y máxima funcionalidad.",
          "url": "/s?q=COOKUT"
        }
      ]
    }
  }
}
