{
  "$extends": [
    "#/$defs/base-component"
  ],
  "$componentKey": "ShipinShelf",
  "$componentTitle": "Shipin Shelf",
  "title": "Shipin Shelf",
  "description": "Product shelf with \"Ver más\" link and optional promo card",
  "type": "object",
  "required": [],
  "properties": {
    "preset": {
      "title": "Preset (fills title, images and sort)",
      "type": "string",
      "enum": [
        "custom",
        "nuevos-ingresos",
        "naranja",
        "gamer",
        "xp-pen",
        "cecotec",
        "computadora",
        "aiper",
        "cocina"
      ],
      "default": "cecotec"
    },
    "title": {
      "title": "Title (overrides preset)",
      "type": "string"
    },
    "moreUrl": {
      "title": "\"Ver más\" URL (overrides preset)",
      "type": "string"
    },
    "collection": {
      "title": "Collection ID (optional)",
      "type": "string"
    },
    "term": {
      "title": "Search term (optional)",
      "type": "string"
    },
    "numberOfItems": {
      "title": "Number of products",
      "type": "integer",
      "default": 10
    },
    "promo": {
      "title": "Promo card (overrides preset)",
      "type": "object",
      "properties": {
        "image": {
          "title": "Card image URL",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "subtitle": {
          "title": "Subtitle",
          "type": "string"
        },
        "ctaLabel": {
          "title": "Button label",
          "type": "string"
        },
        "url": {
          "title": "Button URL",
          "type": "string"
        },
        "background": {
          "title": "Section background image URL",
          "type": "string"
        }
      }
    }
  }
}
