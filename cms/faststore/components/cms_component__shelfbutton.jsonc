{
  "$extends": [
    "#/$defs/base-component"
  ],
  "$componentKey": "ShelfButton",
  "$componentTitle": "Shelf Button",
  "title": "Shelf Button",
  "description": "Centered pill link, e.g. under a product shelf",
  "type": "object",
  "required": [
    "text",
    "url"
  ],
  "properties": {
    "text": {
      "title": "Text",
      "type": "string",
      "default": "Ver más"
    },
    "url": {
      "title": "URL",
      "type": "string"
    }
  }
}
