{
  "$extends": ["#/$defs/base-component"],
  "$componentKey": "EditorialHero",
  "$componentTitle": "Editorial Hero",
  "title": "Editorial Hero",
  "description": "Side-by-side full-bleed campaign photos with a CTA",
  "type": "object",
  "properties": {
    "panels": {
      "title": "Panels",
      "type": "array",
      "items": {
        "title": "Panel",
        "type": "object",
        "required": ["image"],
        "properties": {
          "image": {"title":"Image","type":"object","required":["src"],"properties":{"src":{"title":"Image URL","type":"string"},"alt":{"title":"Alternative text","type":"string"}}},
          "title": { "title": "Title", "type": "string" },
          "buttonLabel": { "title": "Button label", "type": "string", "default": "VER MÁS" },
          "url": { "title": "Link URL", "type": "string" }
        }
      }
    }
  }
}
