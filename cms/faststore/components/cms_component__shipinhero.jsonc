        {
          "image": {
            "src": "https://mundofixar.vtexassets.com/assets/vtex.file-manager-graphql/images/3a4e7698-e773-48d8-9469-4812fb49ef62___6e4e6f9552dcc851be9cd5fc0c5d3124.png",
