{
  "$extends": [
    "#/$defs/base-component"
  ],
  "$componentKey": "ShipinHero",
  "$componentTitle": "Shipin Hero",
  "title": "Shipin Hero",
  "description": "Full-width banner carousel with peeking slides",
  "type": "object",
  "required": [
    "slides"
  ],
  "properties": {
    "slides": {
      "title": "Slides",
      "type": "array",
      "items": {
        "title": "Slide",
        "type": "object",
        "required": [
          "image"
        ],
        "properties": {
          "image": {
            "title": "Image",
            "type": "object",
            "required": [
              "src"
            ],
            "properties": {
              "src": {
                "title": "Image URL",
                "type": "string"
              },
              "alt": {
                "title": "Alternative Label",
                "type": "string"
              }
            }
          },
          "url": {
            "title": "Link URL",
            "type": "string"
          }
        }
      },
      "default": [
        {
          "image": {
            "src": "https://mundofixar.vtexassets.com/assets/vtex.file-manager-graphql/images/f05265da-2f9f-48ef-a49d-4d67eb9b7582___87d9a9b657fea6c490aec24c9e61bc04.png",
            "alt": "Proyectores"
          },
          "url": "/s"
        },
        {
          "image": {
            "src": "https://mundofixar.vtexassets.com/assets/vtex.file-manager-graphql/images/ca8e57da-effe-43c5-b83b-205797f542b7___089877bdc425ccfce363c97d91d30aef.png",
            "alt": "Mundo Gaming"
          },
          "url": "/s"
        },
        {
          "image": {
            "src": "https://mundofixar.vtexassets.com/assets/vtex.file-manager-graphql/images/ca94f578-aa3f-4348-9564-82e213cf9a11___6fca972f1a02d42c8d9cabe1d82916aa.png",
            "alt": "Lanzamiento Aiper"
          },
          "url": "/s"
        },
        {
          "image": {
            "src": "https://mundofixar.vtexassets.com/assets/vtex.file-manager-graphql/images/289d4573-d354-4fa4-b96a-e7540aa8af8e___86fa2dbc2a375194a97c40438e5835d2.png",
            "alt": "Lanzamiento Anthbot"
          },
          "url": "/s"
        },
        {
          "image": {
            "src": "https://mundofixar.vtexassets.com/assets/vtex.file-manager-graphql/images/3119952c-572e-4a7a-a016-3eb59af5dd10___4d3a0a3600b7f510c485d70f0549f47c.png",
            "alt": "Mambo robot de cocina"
          },
          "url": "/s"
