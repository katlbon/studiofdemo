{
  "$extends": [
    "#/$defs/base-component"
  ],
  "$componentKey": "PromoSlider",
  "$componentTitle": "Promo Slider",
  "title": "Promo Slider",
  "description": "Dark promo banners with photo, title, highlight and call to action",
  "type": "object",
  "required": [
    "slides"
  ],
  "properties": {
    "slides": {
      "title": "Slides",
      "type": "array",
      "minItems": 1,
      "items": {
        "title": "Slide",
        "type": "object",
        "required": [
          "image",
          "title"
        ],
        "properties": {
          "image": {
            "title": "Image",
            "type": "object",
            "required": [
              "src"
            ],
            "properties": {
              "src": {
                "title": "Image URL",
                "type": "string",
                "description": "Full image URL"
              },
              "alt": {
                "title": "Alternative Label",
                "type": "string"
              }
            }
          },
          "eyebrow": {
            "title": "Eyebrow",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "highlight": {
            "title": "Highlight",
            "type": "string",
            "description": "Large text, e.g. a price"
          },
          "link": {
            "title": "Call to Action",
            "type": "object",
            "required": [],
            "properties": {
              "text": {
                "title": "Text",
                "type": "string",
                "default": "Ver más"
              },
              "url": {
                "title": "URL",
                "type": "string"
              }
            }
          }
        }
      }
    },
    "autoplaySeconds": {
      "title": "Autoplay interval (seconds, 0 = off)",
      "type": "integer",
      "default": 7
    }
  }
}
