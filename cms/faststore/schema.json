{
  "$base": "vtex.faststore@4",
  "components": {
    "CategoryCarousel": {
      "$extends": [
        "#/$defs/base-component"
      ],
      "$componentKey": "CategoryCarousel",
      "$componentTitle": "Category Carousel",
      "title": "Category Carousel",
      "description": "Scrollable row of category image tiles with a title and call to action",
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "title": {
          "title": "Section title",
          "type": "string",
          "description": "Underlined heading shown above the carousel, e.g. Women"
        },
        "items": {
          "title": "Categories",
          "type": "array",
          "minItems": 1,
          "items": {
            "title": "Category",
            "type": "object",
            "required": [
              "title",
              "image",
              "link"
            ],
            "properties": {
              "title": {
                "title": "Title",
                "type": "string"
              },
              "image": {
                "title": "Image",
                "type": "object",
                "required": [
                  "src"
                ],
                "properties": {
                  "src": {
                    "title": "Image URL",
                    "type": "string",
                    "description": "Full image URL, e.g. a product photo from the catalog"
                  },
                  "alt": {
                    "title": "Alternative Label",
                    "type": "string"
                  }
                }
              },
              "link": {
                "title": "Call to Action",
                "type": "object",
                "required": [
                  "text",
                  "url"
                ],
                "properties": {
                  "text": {
                    "title": "Text",
                    "type": "string",
                    "default": "Ver más"
                  },
                  "url": {
                    "title": "URL",
                    "type": "string"
                  },
                  "linkTargetBlank": {
                    "title": "Open link in new window?",
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        }
      }
    },
    "HeroSlider": {
      "$extends": [
        "#/$defs/base-component"
      ],
      "$componentKey": "HeroSlider",
      "$componentTitle": "Hero Slider",
      "title": "Hero Slider",
      "description": "Full-width image slider with dots and autoplay",
      "type": "object",
      "required": [
        "slides"
      ],
      "properties": {
        "slides": {
          "title": "Slides",
          "type": "array",
          "minItems": 1,
          "items": {
            "title": "Slide",
            "type": "object",
            "required": [
              "image"
            ],
            "properties": {
              "image": {
                "title": "Image",
                "type": "object",
                "required": [
                  "src"
                ],
                "properties": {
                  "src": {
                    "title": "Image URL",
                    "type": "string",
                    "description": "Full image URL"
                  },
                  "alt": {
                    "title": "Alternative Label",
                    "type": "string"
                  }
                }
              },
              "url": {
                "title": "Link URL",
                "type": "string"
              }
            }
          }
        },
        "autoplaySeconds": {
          "title": "Autoplay interval (seconds, 0 = off)",
          "type": "integer",
          "default": 6
        }
      }
    },
    "ImageBanner": {
      "$extends": [
        "#/$defs/base-component"
      ],
      "$componentKey": "ImageBanner",
      "$componentTitle": "Image Banner",
      "title": "Image Banner",
      "description": "Thin full-width promotional image strip",
      "type": "object",
      "required": [
        "image"
      ],
      "properties": {
        "image": {
          "title": "Image",
          "type": "object",
          "required": [
            "src"
          ],
          "properties": {
            "src": {
              "title": "Image URL",
              "type": "string",
              "description": "Full image URL"
            },
            "alt": {
              "title": "Alternative Label",
              "type": "string"
            }
          }
        },
        "url": {
          "title": "Link URL",
          "type": "string"
        },
        "linkTargetBlank": {
          "title": "Open link in new window?",
          "type": "boolean",
          "default": false
        }
      }
    },
    "Marquee": {
      "$extends": [
        "#/$defs/base-component"
      ],
      "$componentKey": "Marquee",
      "$componentTitle": "Marquee",
      "title": "Marquee",
      "description": "Full-width strip of promo messages that scrolls continuously",
      "type": "object",
      "required": [
        "messages"
      ],
      "properties": {
        "messages": {
          "title": "Messages",
          "type": "array",
          "minItems": 1,
          "items": {
            "title": "Message",
            "type": "string"
          }
        },
        "speed": {
          "title": "Seconds per loop (lower is faster)",
          "type": "integer",
          "default": 40,
          "minimum": 5
        }
      }
    },
    "PromoSlider": {
      "$extends": [
        "#/$defs/base-component"
      ],
      "$componentKey": "PromoSlider",
      "$componentTitle": "Promo Slider",
      "title": "Promo Slider",
      "description": "Dark promo banners with photo, title, highlight and call to action",
      "type": "object",
      "required": [
        "slides"
      ],
      "properties": {
        "slides": {
          "title": "Slides",
          "type": "array",
          "minItems": 1,
          "items": {
            "title": "Slide",
            "type": "object",
            "required": [
              "image",
              "title"
            ],
            "properties": {
              "image": {
                "title": "Image",
                "type": "object",
                "required": [
                  "src"
                ],
                "properties": {
                  "src": {
                    "title": "Image URL",
                    "type": "string",
                    "description": "Full image URL"
                  },
                  "alt": {
                    "title": "Alternative Label",
                    "type": "string"
                  }
                }
              },
              "eyebrow": {
                "title": "Eyebrow",
                "type": "string"
              },
              "title": {
                "title": "Title",
                "type": "string"
              },
              "highlight": {
                "title": "Highlight",
                "type": "string",
                "description": "Large text, e.g. a price"
              },
              "link": {
                "title": "Call to Action",
                "type": "object",
                "required": [],
                "properties": {
                  "text": {
                    "title": "Text",
                    "type": "string",
                    "default": "Ver más"
                  },
                  "url": {
                    "title": "URL",
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "autoplaySeconds": {
          "title": "Autoplay interval (seconds, 0 = off)",
          "type": "integer",
          "default": 7
        }
      }
    },
    "SearchBar": {
      "$extends": [
        "#/$defs/base-component"
      ],
      "$componentKey": "SearchBar",
      "$componentTitle": "Search Bar",
      "title": "Search Bar",
      "description": "Full-width search field under the header on mobile and tablet",
      "type": "object",
      "required": [],
      "properties": {
        "placeholder": {
          "title": "Placeholder",
          "type": "string",
          "default": "What are you looking for?"
        }
      }
    },
    "ShelfButton": {
      "$extends": [
        "#/$defs/base-component"
      ],
      "$componentKey": "ShelfButton",
      "$componentTitle": "Shelf Button",
      "title": "Shelf Button",
