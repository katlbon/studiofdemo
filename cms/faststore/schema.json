      "type": "object",
      "required": [
        "text",
        "url"
      ],
      "properties": {
        "text": {
          "title": "Text",
          "type": "string",
          "default": "Ver más"
        },
        "url": {
          "title": "URL",
          "type": "string"
        }
      }
    },
    "ShipinBankPromos": {
